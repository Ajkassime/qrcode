# ==============================================================================
# Fichier d'exemple de configuration d'environnement (.env.example)
# Copiez ce fichier vers .env et définissez des permissions strictes (chmod 600 .env)
# Ne commitez JAMAIS de vraies clés API ou secrets dans le dépôt git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Service de géocodage inverse GPS mondial (OpenCage, BigDataCloud, Nominatim, Google, Mapbox)
# ------------------------------------------------------------------------------
REVERSE_GEOCODER_ENABLED=false
REVERSE_GEOCODER_PROVIDER=opencage
REVERSE_GEOCODER_API_KEY=
REVERSE_GEOCODER_ENDPOINT=
REVERSE_GEOCODER_TIMEOUT=1.5
REVERSE_GEOCODER_CACHE_TTL=86400
REVERSE_GEOCODER_MAX_RPM=60
REVERSE_GEOCODER_DAILY_QUOTA=2500
REVERSE_GEOCODER_USER_AGENT=QRCodePlatform-GeoResolver/1.0
REVERSE_GEOCODER_TOS_ACCEPTED=true

# ------------------------------------------------------------------------------
# Fournisseur secondaire GeoIP IP (Optionnel, désactivé par défaut)
# ------------------------------------------------------------------------------
GEOSECONDARY_ENABLED=false
GEOSECONDARY_PROVIDER=ipinfo
GEOSECONDARY_API_KEY=
GEOSECONDARY_URL=
GEOSECONDARY_TIMEOUT=1.5
GEOSECONDARY_CACHE_TTL=86400

# ------------------------------------------------------------------------------
# Mandataires inverses (Reverse Proxies & Cloudflare)
# ------------------------------------------------------------------------------
# Liste d'adresses IP ou blocs CIDR de reverse proxies de confiance (ex. 10.0.0.1, 192.168.1.0/24)
TRUSTED_PROXY_IPS=
# Activer UNIQUEMENT si l'application est hébergée derrière le proxy Cloudflare
TRUST_CLOUDFLARE_PROXY=false
